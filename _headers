# CleanNest — response headers.
#
# Consumed by Cloudflare Pages (project "cleannest", build: `npm run build`,
# output dir "."). GitHub Pages ignores this file and serves it as a static
# text file, which is harmless.
#
# Note: production HTML is served through the `cleannest-redirects` Worker,
# which proxies to https://cleannest.pages.dev and returns that response
# untouched — so these headers reach real visitors. Redirect responses (301s)
# are generated by the Worker itself and do not carry them; that is expected.

# Content-hashed build output: the filename changes whenever the bytes change,
# so it is safe to cache hard. Without this, Pages answers every request with
# `cache-control: public, max-age=0, must-revalidate`, forcing every visitor to
# re-validate every stylesheet and script on every page view.
#
# Deliberately NOT applied to /assets/img/* or /assets/fonts/* — those files are
# not content-hashed and get replaced in place, so they must keep revalidating.
/assets/generated/*
  Cache-Control: public, max-age=31536000, immutable

# The deploy publishes the repository root, so build sources, test files and the
# content model are fetchable. They hold nothing secret, but they are not site
# content and should never appear in search results.
/site/*
  X-Robots-Tag: noindex
/scripts/*
  X-Robots-Tag: noindex
/tests/*
  X-Robots-Tag: noindex
/package.json
  X-Robots-Tag: noindex
/package-lock.json
  X-Robots-Tag: noindex
/*.md
  X-Robots-Tag: noindex
/CONTENT_ARCHITECTURE.md
  X-Robots-Tag: noindex

# The API catalog has no filename extension (RFC 9727 fixes the path at
# /.well-known/api-catalog), so Pages has nothing to infer a type from. It is a
# linkset per RFC 9264, which is what RFC 9727 Section 3 defines the document as.
/.well-known/api-catalog
  Content-Type: application/linkset+json

# Site-wide security headers. HTML keeps its default revalidation (it changes
# on every deploy).
#
# The Link headers advertise the machine-readable resources an agent can use to
# understand this site and its one API, so it does not have to infer them from
# rendered HTML. Every target exists and answers 200: the catalog and the
# OpenAPI description are static files under .well-known/, and the sitemap is
# generated by the build. `service-doc` is deliberately absent — there is no
# human-readable API documentation to point at, and inventing one to fill the
# relation would advertise a document that only restates the OpenAPI file.
/*
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </.well-known/openapi.json>; rel="service-desc"
  Link: </sitemap.xml>; rel="describedby"
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
