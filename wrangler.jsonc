{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cleannest-redirects",
  "main": "hosting/redirect-worker.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "routes": [
    {
      "pattern": "cleannest.in/*",
      "zone_name": "cleannest.in"
    },
    {
      "pattern": "www.cleannest.in/*",
      "zone_name": "cleannest.in"
    }
  ]
}
